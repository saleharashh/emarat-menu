PORT=4000

# Option 1: Connection string (used on Railway via ${{Postgres.DATABASE_URL}})
DATABASE_URL=
DB_SSL=false
DB_SYNCHRONIZE=true

# Option 2: Individual DB credentials (local dev fallback when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=emarat_menu

JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTO_SEED=false

UPLOAD_DIR=
CORS_ORIGIN=http://localhost:3000
